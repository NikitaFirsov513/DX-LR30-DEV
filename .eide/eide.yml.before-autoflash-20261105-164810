version: "4.1"
name: dx_lr30_pj26
type: ARM
deviceName: STM32F103C8
packDir: null
srcDirs:
  - Core
  - Driver
  - Main
  - LR_driver
  - quequ
  - SDK/STM32F1xx_HAL_Driver/Src
virtualFolder:
  name: <virtual_root>
  files: []
  folders: []
dependenceList: []
outDir: build
miscInfo:
  uid: 658791932b9ff2f79d93f8a345d93c5e
targets:
  Radio:
    cppPreprocessAttrs:
      defineList:
        - USE_HAL_DRIVER
        - STM32F103xB
        - HSE_VALUE=8000000
      incList:
        - Core
        - Driver
        - Main
        - LR_driver
        - LR_driver/src
        - quequ
        - SDK/CMSIS/Include
        - SDK/CMSIS/Device/ST/STM32F1xx/Include
        - SDK/STM32F1xx_HAL_Driver/Inc
      libList: []
    excludeList: []
    settings: {}
    toolchain: GCC
    toolchainConfigMap:
      GCC:
        archExtensions: ""
        cpuType: Cortex-M3
        floatingPointHardware: none
        options:
          version: 5
          afterBuildTasks: []
          asm-compiler:
            ASM_FLAGS: ""
          beforeBuildTasks: []
          c/cpp-compiler:
            CXX_FLAGS: ""
            C_FLAGS: -Wno-unused-parameter
            language-c: c11
            language-cpp: c++11
            one-elf-section-per-data: true
            one-elf-section-per-function: true
            optimization: level-size
            warnings: all-warnings
          global:
            $float-abi-type: soft
            misc-control: []
            not-use-syscalls: true
            output-debug-info: enable
            use-newlib-nano: true
          linker:
            $outputTaskExcludes: []
            LD_FLAGS: ""
            LIB_FLAGS: ""
            output-format: elf
            remove-unused-input-sections: true
        scatterFilePath: STM32F103C8TX_FLASH.ld
        storageLayout:
          RAM: []
          ROM: []
        useCustomScatterFile: true
    uploadConfigMap:
      Custom:
        bin: ""
        commandLine: powershell.exe -NoProfile -ExecutionPolicy Bypass -File "tools/flash.ps1" -Firmware "${programFile}" -Port "${port}"
        eraseChipCommand: ""
    uploader: Custom
