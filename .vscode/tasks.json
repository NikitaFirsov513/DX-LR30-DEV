{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Radio",
      "type": "process",
      "command": "${config:pj26.python}",
      "args": [
        "tools/build.py",
        "--target",
        "Radio"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Flash Radio",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "tools/flash.ps1",
        "-Firmware",
        "build/Radio/dx_lr30_pj26.hex"
      ],
      "dependsOn": "Build Radio",
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build UART",
      "type": "process",
      "command": "${config:pj26.python}",
      "args": [
        "tools/build.py",
        "--target",
        "UART"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Flash UART",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "tools/flash.ps1",
        "-Firmware",
        "build/UART/dx_lr30_pj26.hex"
      ],
      "dependsOn": "Build UART",
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Check project",
      "type": "process",
      "command": "${config:pj26.python}",
      "args": [
        "tools/test.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "List boards",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "tools/flash.ps1",
        "-ListPorts"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Flash console preview",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "tools/flash.ps1",
        "-Preview"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "EIDE: build",
      "command": "${command:eide.project.build}",
      "problemMatcher": []
    },
    {
      "label": "EIDE: flash",
      "command": "${command:eide.project.uploadToDevice}",
      "problemMatcher": []
    },
    {
      "label": "Test radio link",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "tools/test-link.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "detail": "Автоматически выбрать две PJ26 и проверить по 20 пакетов в обе стороны; закрыть HTerm."
    },
    {
      "label": "Test radio link preview",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "tools/test-link.ps1",
        "-Preview"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "detail": "Предпросмотр консоли и отчётов без открытия COM-портов."
    },
    {
      "label": "Test radio link: choose ports",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "tools/test-link.ps1",
        "-PortA",
        "${input:linkPortA}",
        "-PortB",
        "${input:linkPortB}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "detail": "Ввести COM-порты двух PJ26 вручную, затем проверить связь."
    }
  ],
  "inputs": [
    {
      "id": "linkPortA",
      "type": "promptString",
      "description": "PJ26 board A COM port (see List boards)"
    },
    {
      "id": "linkPortB",
      "type": "promptString",
      "description": "PJ26 board B COM port (different from A)"
    }
  ]
}
