set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ARM_GCC_DIR)
set(ARM_GCC_DIR "$ENV{ARM_GCC_DIR}" CACHE PATH "Arm GCC bin directory or installation root")
if(ARM_GCC_DIR AND EXISTS "${ARM_GCC_DIR}/bin")
    set(ARM_GCC_DIR "${ARM_GCC_DIR}/bin")
endif()
find_program(CMAKE_C_COMPILER arm-none-eabi-gcc HINTS "${ARM_GCC_DIR}" REQUIRED)
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
get_filename_component(compiler_dir "${CMAKE_C_COMPILER}" DIRECTORY)
find_program(CMAKE_OBJCOPY arm-none-eabi-objcopy HINTS "${compiler_dir}" REQUIRED)
find_program(CMAKE_SIZE arm-none-eabi-size HINTS "${compiler_dir}" REQUIRED)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
